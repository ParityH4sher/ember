# Non-secret settings for the Authentik stack. Ansible writes .env from the
# stack's `env` mapping in the inventory. Never put secrets here.

# Loopback port for the Authentik web UI and OIDC endpoints, for administration
# over SSH.
HTTP_PORT=9000

# Public route through the Traefik ingress. While PUBLIC_ROUTE is true, the
# server's labels route PUBLIC_HOST to it. The homelab inventory sets both from
# ingress_domain and authentik_public_host.
PUBLIC_ROUTE=false
PUBLIC_HOST=

# Optional AUTHENTIK_* settings are passed to the server and worker, for example:
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__FROM=authentik@example.com
