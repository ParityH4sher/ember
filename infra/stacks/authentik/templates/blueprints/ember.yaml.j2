{#- Ember's OpenID Connect client. Rendered by the Ansible `stack` role from
    the same ember_oidc_* inventory values that roles/ember writes into
    Ember's auth.json. It renders to nothing (and is not installed) while Ember
    sign-in is disabled. -#}
{%- if ember_oidc_enabled | default(false) | bool -%}
# Managed by Ansible from ember_oidc_* in the inventory; local edits are overwritten.
version: 1
metadata:
  name: Ember sign-in
  labels:
    blueprints.goauthentik.io/description: OpenID Connect client for the Ember API
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: ember-provider
    identifiers:
      name: Ember
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: {{ ember_oidc_client_id | default('ember') | to_json }}
      client_secret: !File /run/secrets/ember_oidc_client_secret
      redirect_uris:
        - matching_mode: strict
          url: {{ ember_oidc_redirect_url | to_json }}
          redirect_uri_type: authorization
{% if ember_oidc_post_logout_redirect_url | default('') %}
        - matching_mode: strict
          url: {{ ember_oidc_post_logout_redirect_url | to_json }}
          redirect_uri_type: logout
{% endif %}
      grant_types:
        - authorization_code
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
      # Ember verifies RS256 signatures; never fall back to HS256.
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      include_claims_in_id_token: true
      sub_mode: hashed_user_id
  - model: authentik_core.application
    identifiers:
      slug: ember
    attrs:
      name: Ember
      provider: !KeyOf ember-provider
{% if ember_public_url | default('') %}
      meta_launch_url: {{ (ember_public_url ~ '/') | to_json }}
{% endif %}
{%- endif %}
