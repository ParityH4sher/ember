{#- Rendered by the Ansible `stack` role from `ingress_routes`: the curated
    routes ({name, host, url}). Their high priority keeps container labels
    from taking over these hostnames. -#}
{%- set routers = {} -%}
{%- set services = {} -%}
{%- for route in ingress_routes -%}
{%- set _ = routers.update({route.name: {
      'rule': 'Host(`' ~ route.host ~ '`)',
      'entryPoints': ['tunnel'],
      'priority': 10000,
      'service': route.name}}) -%}
{%- set _ = services.update({route.name: {
      'loadBalancer': {'servers': [{'url': route.url}]}}}) -%}
{%- endfor -%}
# Managed by Ansible from ingress_routes; local edits are overwritten.
# public-https is applied to every router on the tunnel entry point, including
# routers that containers define with labels.
{{ {'http': {
      'middlewares': {'public-https': {'headers': {'customRequestHeaders': {'X-Forwarded-Proto': 'https'}}}},
      'routers': routers,
      'services': services}} | to_nice_yaml(indent=2) }}
