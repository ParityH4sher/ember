# Operator secrets for infra/ansible/playbooks/stacks.yml.
# Copy to .env (gitignored, chmod 600) and fill in. Ansible reads it on the
# controller and installs each value as a secret file on the host
# (/opt/stacks/<stack>/secrets/<name>); nothing here becomes an environment
# variable in a container. Values may be quoted with ' or ".
#
# This file is outside every Docker build context and every directory Ansible
# copies to the host. Keep it that way.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the eyJ… token.
# Becomes stack_secrets.cloudflared.cloudflare_tunnel_token.
CLOUDFLARE_TUNNEL_TOKEN=
