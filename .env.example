# Operator secrets for infra/ansible/playbooks/stacks.yml, and settings for
# the browser tests against a deployment (EMBER_E2E_*, at the end).
# Copy to .env (gitignored, chmod 600) and fill in. Ansible reads only the
# keys it knows, on the controller, and installs each as a secret file on the
# host (/opt/stacks/<stack>/secrets/<name>); none becomes an environment
# variable in a container. Only the EMBER_E2E_* lines reach the test runner.
# Values may be quoted with ' or ".
#
# This file is outside every Docker build context and every directory Ansible
# copies to the host. Keep it that way.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the eyJ… token.
# Becomes stack_secrets.cloudflared.cloudflare_tunnel_token.
CLOUDFLARE_TUNNEL_TOKEN=

# Browser tests against a deployed Ember (apps/frontends/web/tests/real).
# Not used by Ansible. The test runner reads only the EMBER_E2E_* lines.
# Ember's public origin, with the protocol and no path, e.g. https://ember.example.com
EMBER_E2E_BASE_URL=
# Test accounts; ember_e2e_users: true creates them. The password is in the
# Authentik stack's secrets/ember_e2e_password on the host.
EMBER_E2E_USER=ember-e2e-user
EMBER_E2E_PASSWORD=
EMBER_E2E_ADMIN_USER=ember-e2e-admin
# Defaults to EMBER_E2E_PASSWORD.
EMBER_E2E_ADMIN_PASSWORD=
# Optional: command that restarts the API container (Redis session test).
EMBER_E2E_RESTART_API=
# Optional: 1 accepts self-signed certificates.
EMBER_E2E_IGNORE_HTTPS_ERRORS=
