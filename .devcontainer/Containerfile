FROM mcr.microsoft.com/devcontainers/javascript-node:24-bookworm

# Claude Code, a development aid in this container only, not part of Ember.
# Set the build arg to an empty string to build without it.
ARG CLAUDE_CODE_VERSION=2.1.323

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        make \
        python3 \
        python3-pip \
        sshpass \
        yamllint \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Browsers for Playwright: the web app's test suites (apps/frontends/web,
# npm run test:ui / test:real) and the Playwright and Chrome DevTools MCP
# tools Claude Code uses. Keep PLAYWRIGHT_VERSION equal to @playwright/test in
# apps/frontends/web/package.json, so the bundled Chromium build matches.
# install-deps adds the system libraries; Google Chrome (the MCP tools'
# default browser at /opt/google/chrome) is published for amd64 only.
ARG PLAYWRIGHT_VERSION=1.64.1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
        npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chrome; \
    fi \
    && chown -R node:node /ms-playwright \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /root/.npm

USER node
# The npm global prefix is owned by node, so Claude Code's updater can replace
# it without root. ~/.claude is the mount point of the config volume and must
# exist with node as its owner before the volume is first created. The
# package's postinstall links the native binary for this platform; allow it
# by name so it keeps running once npm stops running install scripts by default.
RUN mkdir -p /home/node/.claude \
    && if [ -n "${CLAUDE_CODE_VERSION}" ]; then \
        npm install -g --no-audit --no-fund \
            --allow-scripts=@anthropic-ai/claude-code \
            "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        && claude --version \
        && npm cache clean --force; \
    fi
WORKDIR /workspaces/ember
