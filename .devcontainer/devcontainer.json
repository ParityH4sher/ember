{
  "name": "Ember development",
  "build": {
    "dockerfile": "Containerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.4"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "overrideCommand": true,
  "remoteUser": "node",
  "containerUser": "node",
  "updateRemoteUserUID": false,
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ember,type=bind,relabel=shared",
  "workspaceFolder": "/workspaces/ember",
  "mounts": [
    "type=volume,source=ember-web-modules-${devcontainerId},target=/workspaces/ember/apps/frontends/web/node_modules",
    "type=volume,source=ember-web-kit-${devcontainerId},target=/workspaces/ember/apps/frontends/web/.svelte-kit",
    "type=volume,source=ember-docs-modules-${devcontainerId},target=/workspaces/ember/website/node_modules"
  ],
  "remoteEnv": {
    "PATH": "/home/node/.venvs/ember-ansible/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "init": true,
  "appPort": ["127.0.0.1:3000:3000", "127.0.0.1:5173:5173"],
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "Ember docs",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    },
    "5173": {
      "label": "Ember web (Vite)",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "CHOKIDAR_USEPOLLING": "true",
    "CHOKIDAR_INTERVAL": "1000",
    "WATCHPACK_POLLING": "1000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "golang.go",
        "svelte.svelte-vscode",
        "ms-azuretools.vscode-docker",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "42Crunch.vscode-openapi",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-mermaid",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "typescript.tsdk": "apps/frontends/web/node_modules/typescript/lib",
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "yaml.validate": true,
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true
      }
    }
  }
}
