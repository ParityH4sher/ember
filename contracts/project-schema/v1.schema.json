{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ember.local/schemas/project/v1.schema.json",
  "title": "Ember project manifest",
  "description": "Portable metadata manifest for a versioned Ember project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "createdAt", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "createdAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["source", "artifact", "preview", "attachment"]
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
